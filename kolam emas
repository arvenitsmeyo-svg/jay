<!DOCTYPE html>
<html lang="id">

<head>
<meta charset="UTF-8">

<meta
  name="viewport"
  content="width=device-width, initial-scale=1.0, maximum-scale=1.0"
>

<title>🪙 Kolam Emas</title>

<script src="/socket.io/socket.io.js"></script>

<style>

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: "Segoe UI", sans-serif;
}

body {
  min-height: 100vh;
  background:
    radial-gradient(circle at top, #172554, #020617 70%);
  color: #f8fafc;
  overflow-x: hidden;
}

button,
input {
  font: inherit;
}

.screen {
  display: none;
  min-height: 100vh;
  flex-direction: column;
  justify-content: center;
}

.screen.active {
  display: flex;
}

.container {
  width: min(900px, 94%);
  margin: auto;
  padding: 25px 0;
}

h1 {
  text-align: center;
  font-size: clamp(2.3rem, 8vw, 4rem);
  margin-bottom: 10px;
  color: #fbbf24;
  text-shadow: 0 0 35px rgba(251,191,36,.35);
}

.subtitle {
  text-align: center;
  color: #94a3b8;
  margin-bottom: 35px;
}

.btn {
  border: 0;
  border-radius: 13px;
  padding: 14px 28px;
  margin: 8px;
  color: white;
  background: linear-gradient(#f59e0b,#d97706);
  font-weight: bold;
  cursor: pointer;
  transition: .2s;
  box-shadow: 0 6px 25px rgba(245,158,11,.25);
}

.btn:hover {
  transform: translateY(-2px);
}

.btn:disabled {
  opacity: .5;
  cursor: not-allowed;
  transform: none;
}

.btn.secondary {
  background: linear-gradient(#475569,#334155);
  box-shadow: none;
}

.input {
  width: 230px;
  padding: 15px;
  margin: 10px;
  text-align: center;
  color: white;
  background: rgba(255,255,255,.06);
  border: 2px solid rgba(255,255,255,.1);
  border-radius: 12px;
  outline: none;
  font-size: 1.3rem;
  letter-spacing: 4px;
}

.input:focus {
  border-color: #f59e0b;
}

.center {
  text-align: center;
}

.room-code {
  text-align: center;
  font-size: 3rem;
  font-weight: bold;
  letter-spacing: 8px;
  color: #fbbf24;
  margin: 20px 0;
}

.player-list {
  padding: 20px;
  margin: 20px 0;
  background: rgba(255,255,255,.04);
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 15px;
}

.player-item {
  display: flex;
  justify-content: space-between;
  padding: 13px;
  margin: 7px 0;
  background: rgba(255,255,255,.05);
  border-radius: 9px;
}

.player-host {
  color: #fbbf24;
}

.instructions {
  text-align: center;
  color: #94a3b8;
  line-height: 1.7;
  margin-top: 20px;
}

/* GAME */

.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px;
  margin-bottom: 15px;
  background: rgba(0,0,0,.3);
  border-radius: 12px;
}

.player-indicator {
  display: flex;
  gap: 6px;
}

.player-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: #475569;
}

.player-dot.active {
  background: #22c55e;
  box-shadow: 0 0 12px #22c55e;
}

.game-area {
  position: relative;
  height: min(450px, 65vh);
  overflow: hidden;
  border-radius: 25px;
  box-shadow: 0 0 60px rgba(0,0,0,.5);
}

.pool-bg {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(
      ellipse at center,
      #075985,
      #164e63 50%,
      #064e3b
    );
}

.water {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(
      ellipse at center,
      rgba(255,255,255,.12),
      transparent 70%
    );

  animation: water 5s infinite ease-in-out;
}

@keyframes water {

  0%,100% {
    transform: scale(1);
  }

  50% {
    transform: scale(1.04);
  }

}

.pool-hit {
  position: absolute;
  inset: 40px;
  border-radius: 50%;
  border: 3px solid rgba(255,255,255,.12);
  cursor: pointer;
}

.pool-hit.active {
  animation: hit .3s;
}

@keyframes hit {

  from {
    box-shadow: 0 0 0 0 rgba(251,191,36,.7);
  }

  to {
    box-shadow: 0 0 0 40px rgba(251,191,36,0);
  }

}

.coin {
  position: absolute;
  width: 50px;
  height: 50px;
  left: 50%;
  top: -60px;
  transform: translateX(-50%);
  border-radius: 50%;
  background:
    radial-gradient(circle at 30% 30%,#fde68a,#f59e0b);
  box-shadow: 0 0 25px rgba(251,191,36,.5);
  animation: coinFall 1.2s forwards;
}

@keyframes coinFall {

  0% {
    top: -60px;
    transform: translateX(-50%) rotateY(0);
  }

  70% {
    top: 180px;
    transform: translateX(-50%) rotateY(720deg);
  }

  100% {
    top: 200px;
    transform: translateX(-50%) rotateY(1080deg);
  }

}

.result-popup {
  position: absolute;
  z-index: 20;
  top: 50%;
  left: 50%;
  transform: translate(-50%,-50%);
  width: min(420px,90%);
  padding: 30px;
  text-align: center;
  background: rgba(2,6,23,.95);
  border: 2px solid rgba(255,255,255,.1);
  border-radius: 18px;
  opacity: 0;
  pointer-events: none;
  transition: .3s;
}

.result-popup.show {
  opacity: 1;
}

.result-gold {
  color: #fbbf24;
  font-size: 1.8rem;
  font-weight: bold;
}

.result-normal {
  color: #cbd5e1;
  font-size: 1.3rem;
}

.winner {
  position: fixed;
  z-index: 100;
  top: 50%;
  left: 50%;
  transform: translate(-50%,-50%) scale(.5);
  padding: 35px;
  border-radius: 20px;
  background: linear-gradient(135deg,#f59e0b,#d97706);
  font-size: 2rem;
  font-weight: bold;
  opacity: 0;
  pointer-events: none;
  transition: .4s;
}

.winner.show {
  opacity: 1;
  transform: translate(-50%,-50%) scale(1);
}

#toast {
  position: fixed;
  z-index: 200;
  top: 20px;
  left: 50%;
  transform: translateX(-50%);
  padding: 12px 22px;
  border-radius: 10px;
  background: rgba(2,6,23,.95);
  color: #fbbf24;
  opacity: 0;
  pointer-events: none;
  transition: .3s;
}

#toast.show {
  opacity: 1;
}

@media(max-width:600px) {

  .room-code {
    font-size: 2.2rem;
  }

  .game-area {
    height: 55vh;
  }

  .pool-hit {
    inset: 25px;
  }

  .status-bar {
    font-size: .9rem;
  }

  .btn {
    width: min(300px,90%);
  }

}

</style>
</head>

<body>

<div id="toast"></div>

<!-- MENU -->

<section id="menuScreen" class="screen active">

<div class="container">

<h1>🪙 KOLAM EMAS</h1>

<p class="subtitle">
Lempar koin dan lihat keberuntunganmu!
</p>

<div class="center">

<button
class="btn"
onclick="buatRuangan()">
➕ Buat Ruangan Baru
</button>

<br>

<button
class="btn secondary"
onclick="tampilkanGabung()">
🔑 Masuk Pakai Kode
</button>

<div id="gabungArea" style="display:none;margin-top:20px;">

<input
id="kodeInput"
class="input"
inputmode="numeric"
maxlength="4"
placeholder="0000"
>

<br>

<button
class="btn"
onclick="gabungRuangan()">
✅ Gabung
</button>

<button
class="btn secondary"
onclick="sembunyikanGabung()">
❌ Batal
</button>

</div>

</div>

<div class="instructions">

<p>👥 Maksimal 4 pemain</p>
<p>🪙 Lempar koin → tekan kolam</p>
<p>🏆 Peluang emas = 1%</p>

</div>

</div>

</section>


<!-- LOBBY -->

<section id="lobbyScreen" class="screen">

<div class="container">

<h2 class="center">
🏠 Ruangan Permainan
</h2>

<div
id="kodeRuangan"
class="room-code">
----
</div>

<div class="player-list">

<h3>
👥 Pemain
(<span id="jumlahPemain">0</span>/4)
</h3>

<div id="daftarPemain"></div>

</div>

<div class="center">

<button
id="mulaiBtn"
class="btn"
onclick="mulaiGame()">
🎮 Mulai Main
</button>

<button
class="btn secondary"
onclick="kembaliMenu()">
🏠 Keluar
</button>

</div>

<p class="instructions">
📤 Bagikan kode ini kepada temanmu.
</p>

</div>

</section>


<!-- GAME -->

<section id="gameScreen" class="screen">

<div class="container">

<div class="status-bar">

<div>
🪙
<span id="statusText">
Siap bermain!
</span>
</div>

<div
id="tandaPemain"
class="player-indicator">
</div>

</div>

<div class="game-area">

<div class="pool-bg"></div>

<div class="water"></div>

<div
id="kolam"
class="pool-hit"
onclick="tekanKolam()">
</div>

<div id="koinAnim"></div>

<div
id="hasilPopup"
class="result-popup">

<div id="hasilIsi"></div>

</div>

</div>

<div class="center">

<button
id="lemparBtn"
class="btn"
onclick="lemparKoin()">

🪙 Lempar Koin

</button>

<button
class="btn secondary"
onclick="keluarGame()">

🚪 Keluar

</button>

</div>

<p class="instructions">

Setelah koin dilempar,
tekan kolam secepat mungkin!

</p>

</div>

</section>


<div
id="pemenangLayar"
class="winner">
👑 DAPAT EMAS! 👑
</div>


<script>

const socket = io();

let state = {
  layar: "menuScreen",
  kodeRuangan: null,
  saya: null,
  pemain: [],
  status: "siap",
  waktuTunggu: null,
  sudahAksi: false
};


/* =========================================
   CONNECTION
========================================= */

socket.on("connect", () => {

  console.log("🟢 Terhubung ke server");

});

socket.on("disconnect", () => {

  tampilkanPesan("🔴 Koneksi ke server terputus.");

});


/* =========================================
   UI
========================================= */

function gantiLayar(id) {

  document
    .querySelectorAll(".screen")
    .forEach(screen =>
      screen.classList.remove("active")
    );

  const screen = document.getElementById(id);

  if (screen) {
    screen.classList.add("active");
  }

  state.layar = id;

}


function tampilkanPesan(message) {

  const toast = document.getElementById("toast");

  toast.textContent = message;

  toast.classList.add("show");

  clearTimeout(window.toastTimer);

  window.toastTimer =
    setTimeout(() => {
      toast.classList.remove("show");
    }, 2500);

}


function tampilkanGabung() {

  document.getElementById("gabungArea")
    .style.display = "block";

}


function sembunyikanGabung() {

  document.getElementById("gabungArea")
    .style.display = "none";

}


/* =========================================
   BUAT ROOM
========================================= */

function buatRuangan() {

  if (!socket.connected) {
    alert("❌ Belum terhubung ke server.");
    return;
  }

  socket.emit("buatRuangan");

}


/* =========================================
   ROOM CREATED
========================================= */

socket.on("ruanganDibuat", data => {

  state.kodeRuangan = data.kode;
  state.saya = data.saya;

  document.getElementById("kodeRuangan")
    .textContent = data.kode;

  perbaruiDaftarPemain(data.pemain);

  gantiLayar("lobbyScreen");

  tampilkanPesan(
    "🏠 Ruangan berhasil dibuat!"
  );

});


/* =========================================
   JOIN ROOM
========================================= */

function gabungRuangan() {

  const input =
    document.getElementById("kodeInput");

  const kode =
    input.value.trim();

  if (!/^\d{4}$/.test(kode)) {

    alert("⚠️ Masukkan kode 4 angka!");

    return;
  }

  if (!socket.connected) {

    alert("❌ Tidak terhubung ke server.");

    return;
  }

  socket.emit(
    "gabungRuangan",
    { kode },

    response => {

      if (!response) {

        alert("❌ Server tidak memberikan respons.");

        return;
      }

      if (!response.sukses) {

        alert(
          "❌ " +
          (response.pesan ||
           "Gagal masuk ruangan.")
        );

        return;
      }

      state.kodeRuangan = kode;
      state.saya = response.saya;

      document.getElementById(
        "kodeRuangan"
      ).textContent = kode;

      perbaruiDaftarPemain(
        response.pemain
      );

      gantiLayar("lobbyScreen");

      tampilkanPesan(
        "✅ Berhasil masuk!"
      );

    }
  );

}


/* =========================================
   PLAYER UPDATE
========================================= */

socket.on("updatePemain", data => {

  perbaruiDaftarPemain(data.pemain);

});


socket.on("pemainMasuk", data => {

  perbaruiDaftarPemain(data.pemain);

  tampilkanPesan(
    `👤 ${data.nama} bergabung!`
  );

});


socket.on("pemainKeluar", data => {

  perbaruiDaftarPemain(data.pemain);

  tampilkanPesan(
    `🚪 ${data.nama} keluar.`
  );

});


function perbaruiDaftarPemain(list) {

  state.pemain = list || [];

  document.getElementById(
    "jumlahPemain"
  ).textContent = state.pemain.length;

  const container =
    document.getElementById("daftarPemain");

  container.innerHTML =
    state.pemain.map(player => `

      <div class="player-item">

        <span>
          ${escapeHtml(player.nama)}

          ${
            player.id === socket.id
              ? " <strong>(Kamu)</strong>"
              : ""
          }
        </span>

        <span class="player-host">
          ${player.tuan ? "👑 HOST" : ""}
        </span>

      </div>

    `).join("");

  const saya =
    state.pemain.find(
      player => player.id === socket.id
    );

  document.getElementById("mulaiBtn")
    .style.display =
      saya?.tuan
        ? "inline-block"
        : "none";

  perbaruiTandaPemain();

}


/* =========================================
   START GAME
========================================= */

function mulaiGame() {

  socket.emit("mulaiGame");

}


socket.on("mulaiGame", data => {

  state.status = "siap";
  state.sudahAksi = false;

  gantiLayar("gameScreen");

  perbaruiStatus(
    `Ronde ${data.round} — siap!`
  );

  document.getElementById(
    "lemparBtn"
  ).disabled = false;

});


/* =========================================
   THROW COIN
========================================= */

function lemparKoin() {

  if (state.status !== "siap") {
    return;
  }

  state.status = "mengetuk";
  state.sudahAksi = false;

  perbaruiStatus(
    "👆 Tekan kolam sekarang!"
  );

  document.getElementById(
    "lemparBtn"
  ).disabled = true;

  document.getElementById(
    "koinAnim"
  ).innerHTML =
    '<div class="coin"></div>';

  state.waktuTunggu =
    setTimeout(() => {

      if (
        state.status === "mengetuk"
      ) {

        kirimHasil(false);

      }

    }, 1500);

}


/* =========================================
   HIT POOL
========================================= */

function tekanKolam() {

  if (state.status !== "mengetuk") {
    return;
  }

  clearTimeout(state.waktuTunggu);

  const pool =
    document.getElementById("kolam");

  pool.classList.add("active");

  setTimeout(() => {
    pool.classList.remove("active");
  }, 300);

  kirimHasil(true);

}


/* =========================================
   SEND ACTION
========================================= */

function kirimHasil(ditekan) {

  if (state.sudahAksi) return;

  state.sudahAksi = true;

  state.status = "menunggu";

  perbaruiStatus(
    "⏳ Menunggu hasil..."
  );

  socket.emit("aksi", {
    ditekan
  });

}


/* =========================================
   RESULT
========================================= */

socket.on("hasilPutaran", hasil => {

  state.status = "hasil";

  if (hasil.pemainId === socket.id) {

    if (hasil.jenis === "emas") {

      tampilkanHasil(
        "🎉 KAMU DAPAT EMAS! 🪙",
        true
      );

      tampilkanPemenang();

    } else {

      tampilkanHasil(
        `${hasil.barang.emoji}
        ${hasil.barang.nama}`,
        false
      );

    }

  } else {

    if (hasil.jenis === "emas") {

      tampilkanHasil(
        `🏆 ${escapeHtml(
          hasil.pemainNama
        )} mendapatkan EMAS!`,
        false
      );

    } else {

      tampilkanHasil(
        `🪙 ${escapeHtml(
          hasil.pemainNama
        )} mendapatkan sesuatu.`,
        false
      );

    }

  }

  perbaruiTandaPemain(
    hasil.pemainId
  );

});


/* =========================================
   NEXT ROUND
========================================= */

socket.on("rondeBaru", data => {

  state.status = "siap";
  state.sudahAksi = false;

  perbaruiStatus(
    `Ronde ${data.round} — siap!`
  );

  document.getElementById(
    "lemparBtn"
  ).disabled = false;

  document.getElementById(
    "koinAnim"
  ).innerHTML = "";

});


/* =========================================
   RESULT UI
========================================= */

function tampilkanHasil(text, gold) {

  const popup =
    document.getElementById(
      "hasilPopup"
    );

  const content =
    document.getElementById(
      "hasilIsi"
    );

  content.className =
    gold
      ? "result-gold"
      : "result-normal";

  content.innerHTML = text;

  popup.classList.add("show");

  setTimeout(() => {

    popup.classList.remove("show");

  }, 2500);

}


function tampilkanPemenang() {

  const winner =
    document.getElementById(
      "pemenangLayar"
    );

  winner.classList.add("show");

  setTimeout(() => {

    winner.classList.remove("show");

  }, 3000);

}


/* =========================================
   STATUS
========================================= */

function perbaruiStatus(text) {

  document.getElementById(
    "statusText"
  ).textContent = text;

}


/* =========================================
   PLAYER INDICATOR
========================================= */

function perbaruiTandaPemain(activeId) {

  const container =
    document.getElementById(
      "tandaPemain"
    );

  container.innerHTML =
    state.pemain.map(player => `

      <div
        class="player-dot
        ${
          player.id === activeId
            ? "active"
            : ""
        }">
      </div>

    `).join("");

}


/* =========================================
   NAVIGATION
========================================= */

function kembaliMenu() {

  socket.emit("keluarRuangan");

  resetState();

  gantiLayar("menuScreen");

}


function keluarGame() {

  if (
    !confirm(
      "Yakin ingin keluar?"
    )
  ) return;

  socket.emit("keluarRuangan");

  resetState();

  gantiLayar("menuScreen");

}


function resetState() {

  state = {
    layar: "menuScreen",
    kodeRuangan: null,
    saya: null,
    pemain: [],
    status: "siap",
    waktuTunggu: null,
    sudahAksi: false
  };

  document.getElementById(
    "pemenangLayar"
  ).classList.remove("show");

  document.getElementById(
    "koinAnim"
  ).innerHTML = "";

}


/* =========================================
   SECURITY
========================================= */

function escapeHtml(value) {

  return String(value)
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");

}


/* =========================================
   START
========================================= */

gantiLayar("menuScreen");

</script>

</body>
</html>
